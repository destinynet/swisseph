<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>destiny</groupId>
    <artifactId>destiny-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>destiny-swisseph</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <name>destiny-swisseph</name>
  <description>
    A modernized Java port of the Swiss Ephemeris, derived from Thomas Mack's
    swisseph Java library (itself a port of Astrodienst AG's C original).
    See README.md for lineage and LICENSE for the dual licensing terms.
  </description>

  <properties>
    <!-- java version 由 destiny-parent 統一為 21 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            每個測試類別開一個新的 JVM。這個函式庫把狀態放在 static 欄位裡，
            所以 golden master 的「cold」只有在乾淨的 JVM 裡才真的是 cold ——
            若與其他測試類別共用 JVM，前面跑過的測試會先污染它。
            Phase 2 拔掉全域狀態之後，這個設定就可以移除。
          -->
          <reuseForks>false</reuseForks>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    測試框架 (junit-jupiter) 由 destiny-parent 以 test scope 提供，此處不再宣告。
  -->
</project>
